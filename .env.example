# 이 파일은 템플릿입니다. git에 커밋되므로 실제 키를 넣지 마세요.
# 복사해서 .env 를 만들고 거기에 실제 값을 채우세요 (.env 는 .gitignore 처리됨).
#   Copy-Item .env.example .env

# OpenAI - 이미지 Vision 처리(gpt-4.1-mini). 추후 임베딩도 동일 키 사용
OPENAI_API_KEY=

# LlamaParse - PDF/이미지 내 표 파싱. 없으면 PyMuPDF 폴백으로 동작
LLAMA_CLOUD_API_KEY=

# Tesseract 실행파일 경로. PATH에 등록되어 있으면 비워둬도 됨
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# 무료 OCR 을 동시에 몇 갈래로 돌리나. **route_all() 의 병렬 구간에만 쓴다** — 유료
# (Vision·LlamaParse)는 일부러 직렬이고 이유는 loader/content/router.py 에 있다.
# **Tesseract 는 서브프로세스라 GPU 로도 TORCH_NUM_THREADS 로도 못 잡는다** — 적재 쪽
# CPU 발열 손잡이는 이것 하나뿐이다. 8은 한계값이 아니라 무릎이다: 1: 239.8초 /
# 2: 137.7초 / 4: 75.6초 / 8: 51.8초 / 16: 42.3초(직전 대비 -102.1/-62.1/-23.8/-9.5).
# 낮추면 그만큼 느려진다. 근거는 verify_log/2026-08-24-ocr-병렬화.md
# OCR_MAX_WORKERS=8

# 업로드 제한
MAX_UPLOAD_SIZE_MB=50

# 콘텐츠 라우팅 (llamaparse|pymupdf / hybrid|vision|ocr|skip)
# llamaparse 는 표를 HTML 로 돌려줘 rows 를 못 얻는다 — 근거는 plan_log/표-경로.md
# hybrid = pymupdf 로 뽑되, 빈 칸에 벡터 드로잉이 있는 표만 Vision 으로 올려 그 칸만 채운다
# (체크 표시는 이미지도 텍스트도 아니라 무료 경로로는 못 얻는다). 유료 호출이 생긴다
TABLE_PDF_HANDLER=pymupdf
IMAGE_HANDLER=hybrid
VISION_MODEL=gpt-4.1-mini
MAX_VISION_CALLS_PER_DOC=30
# 쪽 위 표시 크기로 장식(반복 글리프·제목 띠)을 거른다. 저장 픽셀 필터와 서로 대신 못 한다 —
# 근거와 임계값 유래는 plan_log/이미지-경로.md 2회차. PDF 만 적용된다(HWPX 는 bbox 가 없다)
MIN_IMAGE_DISPLAY_PT=20
MAX_IMAGE_ASPECT_RATIO=8

# 정리 단계 - PDF가 글머리 기호를 제어 코드포인트로 떨어뜨리는 것을 걷어낸다.
# 표 마크다운의 행 구분자(\n)와 탭은 남기므로 표는 그대로다
REMOVE_CONTROL_CHARS=true

# 연속 공백을 한 칸으로 줄인다
NORMALIZE_WHITESPACE=true

# 쪽마다 되풀이되는 문서 제목·기관명을 지운다.
# 최소 3쪽에 나오고, 첫 등장~마지막 등장 폭이 전체 쪽수의 60% 이상일 때만 머리말로 본다
REMOVE_REPEATED_HEADERS=true
HEADER_MIN_PAGES=3
HEADER_MIN_SPAN_RATIO=0.60

# 글자 크기를 보고 문단을 제목으로 승격한다. PDF·HWPX 는 제목 표시를 파일에 안 남기므로
# 이게 꺼지면 청킹이 끊을 경계를 못 얻어 문서가 큰 덩어리로 뭉친다
DETECT_HEADINGS=true

# 청킹 - 청크 한 개의 상한(글자 수). **임시값이고 실측 전이다.**
# 실측상 텍스트 요소는 최대 554자라 텍스트에서는 거의 발화하지 않고 큰 표에서만 걸린다
MAX_CHUNK_CHARS=1200
# 상한을 넘겨 쪼갠 구간에만 주는 겹침. 섹션 경계와 표에는 주지 않는다
CHUNK_OVERLAP_CHARS=150
# 제목 경로를 청크 본문 맨 앞에 붙인다
INCLUDE_HEADING_IN_TEXT=true

# 임베딩 - 청크 텍스트를 벡터로. **2026-08-25 에 기본값을 KURE-v1 로 갈아탔다** —
# 같은 정답 세트 60건에서 hit@10 이 0.4833(text-embedding-3-small) -> 0.8500 이다
# (plan_log/embedding.md 5회차).
# 구현체. openai | local — local 은 sentence-transformers 경로이고 **키 없이도 돌기 때문에**
# 기본 테스트는 conftest 가 openai 로 못 박는다(그것이 지금 유일한 방어다)
# 런타임 - 프로세스 전역이라 단계별로 못 가른다
# torch 가 쓸 CPU 스레드 수(intra-op). **비우면 물리 코어 전부**(개발 머신 기준 8).
# **임베더와 리랭커가 이 값을 공유한다** — OpenMP 풀이 프로세스에 하나뿐이라 따로 못 준다.
# 둘 다 cuda 로 켜면 대개 놀지만, GPU 를 안 타는 갈래가 셋 남는다: evaluation/ 프로필의
# cpu 핀 · GPU 없는 머신 · VRAM 부족 시 폴백.
# **기본을 안 낮춘 것은 결정이다** — verify_log 의 모든 벽시계가 8스레드에서 나온 값이라,
# 기본을 바꾸면 과거 수치가 조용히 비교 불가가 된다. OCR 에는 안 먹는다(OCR_MAX_WORKERS)
# TORCH_NUM_THREADS=

EMBEDDING_PROVIDER=local
# provider=local 이면 HuggingFace 리포 이름, openai 면 모델 이름(예: text-embedding-3-small)
EMBEDDING_MODEL=nlpai-lab/KURE-v1
# 로컬 모델을 어느 장치에 올리나. cpu | cuda — **기본은 cpu 이고 자동 감지를 안 한다.**
# GPU 를 켠 머신에서만 다른 벡터가 나오면 "baseline 은 재현될 때만 기준선" 이 무너진다.
# 바꾸려면 PyPI 밖 --index-url 로 cu 빌드 torch 를 따로 깔아야 한다(PyPI 휠은 CPU 빌드).
#
# **CPU 발열의 제일 큰 자리다.** 실측(2026-08-26, 실제 청크 414개): cpu 236.4초 /
# CPU-초 1856.7(7.85코어 포화) vs cuda 15.4초 / CPU-초 15.8(1.03코어) — **CPU-초 117배**.
# 벡터는 안 갈리므로(1-cos 최대 1.354e-09) 캐시·컬렉션을 그대로 쓰고 재색인이 필요 없다.
# 다만 **첫 질의는 안 빨라진다** — 그 13초는 연산이 아니라 가중치 적재다.
#
# 평가(evaluation/config.py)는 이 값과 무관하게 **프로필이 이긴다** — GPU 로 돌리려면
# `--embedding kure-v1-gpu` 를 준다. 그것이 재현성 장치이고 버그가 아니다
EMBEDDING_DEVICE=cpu
# 비워두면 모델 기본 차원(KURE-v1 은 1024). text-embedding-3-* 만 이 값으로 줄일 수 있고,
# local 은 MRL 미학습이라 값이 오면 예외다. 캐시 키에 모델명과 함께 들어간다
# EMBEDDING_DIMENSIONS=

# 한 번에 보낼 텍스트 개수. 실측상 문서당 청크가 45~102개라 대부분 1회 호출로 끝난다
EMBEDDING_BATCH_SIZE=100
# 문서 하나당 토큰 상한. 호출 수가 아니라 토큰인 이유: 배치라 청크 500개가 5회 호출로 끝나
# 호출 수 상한은 아무것도 막지 못한다. 실측 최대 51,341토큰의 약 4배로 잡았다
MAX_EMBEDDING_TOKENS_PER_DOC=200000
# 같은 텍스트를 두 번 임베딩하지 않는다
EMBEDDING_CACHE_ENABLED=true

# 색인 - 벡터 저장소(qdrant). **로컬 파일 모드이고 서버·도커가 필요 없다.**
# 그래야 기본 테스트가 키도 서버도 없이 통과한다. 이 경로에 배타 잠금이 걸리므로
# 서버와 스크립트가 같은 경로를 동시에 열 수 없다
QDRANT_PATH=.qdrant
# 컬렉션 이름의 앞부분. 실제 이름에는 임베딩 모델명과 차원이 덧붙는다 —
# 차원만 검사하면 -small(1536)과 축소한 -large(1536)를 못 가려 벡터가 조용히 섞인다
COLLECTION_NAME=documents
# 한 번에 보낼 point 수. 문서당 청크가 45~102개라 대부분 1회로 끝난다
UPSERT_BATCH_SIZE=128

# 검색 - dense(qdrant)와 BM25 를 RRF 로 합친다. 과금 항목이 없다(질의 임베딩은 위 설정 몫).
# BM25 를 켜고 끄는 스위치는 여기 없다 — 인덱스를 안 넘기는 것이 곧 끄는 것이라
# 합법값이 하나뿐인 죽은 설정이 된다(retrieval/hybrid.py docstring)
#
# 각 경로에서 뽑아 합칠 후보 수. **임시값이고 실측 전이다** — dense vs hybrid 측정 뒤 재판정한다.
# 두 경로에 같은 값을 쓴다: 한쪽만 길면 RRF 가 긴 쪽에 유리해져 기울기가 숫자가 아니라
# 구조에서 나오고 원인을 못 짚는다
CANDIDATE_K=50
# RRF 의 순위 완충 상수. score = Σ 1/(RRF_K + rank) 의 그 값이고 **RRF 원 논문 값이다** —
# 우리가 고른 수가 아니라 분포의 틈을 찾을 필요가 없었다
RRF_K=60

# 리랭커 - 후보 풀의 **순서만** 다시 매긴다. 집합을 안 바꾸므로 recall@후보수 로 재면
# 차이가 정의상 0 이다. 바닥은 hit@1, 천장은 hit@후보수 이고 주지표는 nDCG@5·precision@3.
# 구현체가 둘이라 여는 설정이다 — openai(listwise LLM 1회) / local(cross-encoder).
# **local 은 키가 없어도 도는 갈래라** 모델 이름만으로 가중치를 내려받는다
RERANK_PROVIDER=openai
# 무슨 모델로. **비워 두면 리랭커가 통째로 꺼진다(기본).** 비어 있는 것이 미완성이 아니라
# 설계다 — 켜는 순간 질의당 LLM 호출이 1회에서 2회가 되므로, 값을 하는지 재기 전에 과금이
# 먼저 붙는 것을 막는다. openai 면 gpt-4.1-mini 꼴, local 이면 HuggingFace 리포지터리 이름
# (예: BAAI/bge-reranker-v2-m3). 재는 방법은 plan_log/검색-생성.md 5회차
RERANK_MODEL=
# 로컬 구현체를 어느 장치에. **EMBEDDING_DEVICE 와 이름 규칙·기본값을 맞춘 것은 같은
# 함정이라서다** — CPU 와 GPU 가 다른 점수를 내면 같은 명령이 머신마다 다른 순위를 만든다.
# 실측(2026-08-26): 질의당 cpu 63.9초 vs cuda 2.988초로 **21.4배**이고 순위는 전건 동일.
# **EMBEDDING_DEVICE 와 별개 설정이라 둘 다 켜야 한다** — 한쪽만 켜면 나머지가 CPU 를 문다
RERANK_DEVICE=cpu
# 리랭커가 보는 후보 수. CANDIDATE_K 와 같은 수지만 축이 다르다(저쪽은 뽑는 폭, 이쪽은
# 보는 폭). 같은 값인 것은 "풀 전부를 먹인다"가 결정이어서다 — 20으로 자르면 실측으로
# 후보 #30·#26 에 있던 정답을 버린다(verify_log/2026-08-24-리랭커-여지.md)
RERANK_CANDIDATES=50

# 답변 캐시 - 비슷한 질문에 이전 답변을 되돌려준다. **켜면 질의당 LLM 1회가 통째로 빠진다.**
# 컬렉션은 문서와 반드시 갈라 둔다 — 섞으면 BM25 가 전량 훑을 때와 사이드바 문서 목록에
# 캐시 항목이 문서로 섞여 든다
ANSWER_CACHE_COLLECTION_NAME=qa_cache

# 무엇을 "같은 질문"으로 볼지. semantic = 질문 벡터의 유사도(아래 임계값이 그 자[尺]다) /
# exact = 정규화한 문자열이 같은가(임계값을 안 본다).
# **exact 는 이 한 줄만으로 캐시가 켜진다** — 정할 값이 없는 축이라서다.
# 비워 두면 semantic 이고, 아래 임계값도 비어 있어 캐시가 통째로 꺼진 상태가 된다.
# 켤지 정하는 근거는 실사용 질의 로그의 반복률이다 (plan_log/시맨틱-캐시.md 6회차)
ANSWER_CACHE_MODE=semantic
# 이 값 이상이면 "같은 질문"으로 본다. **비워 두면 캐시가 통째로 꺼진다(기본).**
# 비어 있는 것이 미완성이 아니라 설계다 — 이 저장소의 임계값은 전부 분포의 틈에서 나왔는데
# (표 되붙이기 12pt, 표시 면적비 0.08 vs 1.00) 이 축은 아직 안 쟀다. 게다가 임계값은
# **임베딩 모델에 딸린 값**이라 모델을 바꾸면 다시 재야 한다
ANSWER_CACHE_THRESHOLD=

# 생성 - 검색된 근거로 답변 문장을 만든다. 질의당 LLM 1회가 비용의 전부다.
# **모델은 임시값이고 실측 전이다** — 답변 품질을 재는 자[尺]가 아직 없다.
# evaluation/ 의 60건 세트는 gold_spans 가 정답 "문자열"이라 검색을 재지 생성을 못 잰다
GENERATION_MODEL=gpt-4.1-mini
# 답변 길이 상한. 한국어 청크는 문자 ≈ 토큰이라 대략 이만큼의 글자다
GENERATION_MAX_TOKENS=1024
# 근거에서 벗어나지 않는 것이 목적이라 낮게 둔다. 0 이 아닌 것은 표·목록을 통째로 베끼는
# 대신 질문에 맞게 추리는 여지를 남기기 위해서다
GENERATION_TEMPERATURE=0.2
# 컨텍스트에 실을 청크 수. **임시값이다** — baseline 이 hit@5 0.400 / @10 0.483 / @20 0.617
# 이라 늘리면 오르는 것은 알지만, 대가(컨텍스트 토큰·답변 품질)를 재는 쪽이 없어 못 정한다
GENERATION_TOP_K=5
