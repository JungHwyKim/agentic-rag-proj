# 이 파일은 템플릿입니다. git에 커밋되므로 실제 키를 넣지 마세요.
# 복사해서 .env 를 만들고 거기에 실제 값을 채우세요 (.env 는 .gitignore 처리됨).
#   Copy-Item .env.example .env

# OpenAI - 이미지 Vision 처리(gpt-4.1-mini). 추후 임베딩도 동일 키 사용
OPENAI_API_KEY=

# LlamaParse - PDF/이미지 내 표 파싱. 없으면 PyMuPDF 폴백으로 동작
LLAMA_CLOUD_API_KEY=

# Tesseract 실행파일 경로. PATH에 등록되어 있으면 비워둬도 됨
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# 업로드 제한
MAX_UPLOAD_SIZE_MB=50

# 콘텐츠 라우팅 (llamaparse|pymupdf / hybrid|vision|ocr|skip)
TABLE_PDF_HANDLER=llamaparse
IMAGE_HANDLER=hybrid
VISION_MODEL=gpt-4.1-mini
MAX_VISION_CALLS_PER_DOC=30

# 정리 단계 - PDF가 글머리 기호를 제어 코드포인트로 떨어뜨리는 것을 걷어낸다.
# 표 마크다운의 행 구분자(\n)와 탭은 남기므로 표는 그대로다
REMOVE_CONTROL_CHARS=true

# 연속 공백을 한 칸으로 줄인다
NORMALIZE_WHITESPACE=true

# 쪽마다 되풀이되는 문서 제목·기관명을 지운다.
# 최소 3쪽에 나오고, 첫 등장~마지막 등장 폭이 전체 쪽수의 60% 이상일 때만 머리말로 본다
REMOVE_REPEATED_HEADERS=true
HEADER_MIN_PAGES=3
HEADER_MIN_SPAN_RATIO=0.60

# 글자 크기를 보고 문단을 제목으로 승격한다. PDF·HWPX 는 제목 표시를 파일에 안 남기므로
# 이게 꺼지면 청킹이 끊을 경계를 못 얻어 문서가 큰 덩어리로 뭉친다
DETECT_HEADINGS=true

# 청킹 - 청크 한 개의 상한(글자 수). **임시값이고 실측 전이다.**
# 실측상 텍스트 요소는 최대 554자라 텍스트에서는 거의 발화하지 않고 큰 표에서만 걸린다
MAX_CHUNK_CHARS=1200
# 상한을 넘겨 쪼갠 구간에만 주는 겹침. 섹션 경계와 표에는 주지 않는다
CHUNK_OVERLAP_CHARS=150
# 제목 경로를 청크 본문 맨 앞에 붙인다
INCLUDE_HEADING_IN_TEXT=true

# 임베딩 - 청크 텍스트를 벡터로. **모델은 임시값이고 실측 전이다.**
# 모델 간 한국어 검색 품질은 정답 질의 세트가 없어 아직 못 잰다(plan_log/평가-세트.md)
EMBEDDING_MODEL=text-embedding-3-small
# 비워두면 모델 기본 차원(1536). text-embedding-3-* 는 이 값으로 차원을 줄일 수 있다.
# 캐시 키에 모델명과 함께 들어가므로 바꾸면 옛 벡터를 안 쓴다
# EMBEDDING_DIMENSIONS=

# 한 번에 보낼 텍스트 개수. 실측상 문서당 청크가 45~102개라 대부분 1회 호출로 끝난다
EMBEDDING_BATCH_SIZE=100
# 문서 하나당 토큰 상한. 호출 수가 아니라 토큰인 이유: 배치라 청크 500개가 5회 호출로 끝나
# 호출 수 상한은 아무것도 막지 못한다. 실측 최대 51,341토큰의 약 4배로 잡았다
MAX_EMBEDDING_TOKENS_PER_DOC=200000
# 같은 텍스트를 두 번 임베딩하지 않는다
EMBEDDING_CACHE_ENABLED=true
