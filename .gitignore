# 가상환경
.venv/
venv/

# 파이썬
__pycache__/
*.py[cod]
*.egg-info/

# 환경변수 (실제 API 키)
.env

# 테스트/린트 캐시
.pytest_cache/
.ruff_cache/

# 실제 한컴/PDF 회귀 테스트 파일. 샘플은 conftest.py 가 코드로 생성하는 방침이라
# 바이너리는 커밋하지 않는다. test_hwpx_real.py 는 여기 파일이 없으면 조용히 skip한다
tests/fixtures/

# 런타임 데이터
data/
.cache/
# 색인에 성공한 업로드 원본(Settings.originals_dir 기본값). 사용자가 올린 파일 그대로라
# 커밋하면 안 된다. 상한도 자동 정리도 없고 삭제는 화면의 버튼이 한다
original_files/
# qdrant 로컬 파일 모드의 저장 경로(IndexingConfig.qdrant_path 기본값).
# 벡터 DB 바이너리라 커밋하면 안 되고, 임베딩 모델을 바꾸면 내용도 통째로 달라진다
.qdrant/

# PPT 초안 메모 등 임시 작업 파일
/tmp/

# 에디터
.vscode/
.idea/
.codex/
frontend/
output/

# 로컬 작업 지침과 프로젝트 컨텍스트
/AGENTS.md
/project_context/
/plan_log/프로젝트-컨텍스트.md

# backend/preview.py 산출물. 템플릿을 고치면 곧바로 낡아 어느 시점의 화면인지 알 수 없게 된다
/preview.html
