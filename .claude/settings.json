{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.venv/Scripts/python.exe\" \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre_commit_check.py\"",
            "timeout": 900,
            "statusMessage": "커밋 전 린트·빌드·테스트 실행 중..."
          }
        ]
      }
    ]
  }
}
